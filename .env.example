# Getnet multi-agent support: environment variables.
# Copy this file to .env and fill in the two required keys. Never commit .env.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# OpenAI API key, used by the four agents (chat model) and by the embeddings.
# Required. Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Tavily API key, used by the Knowledge agent's web_search tool (weather, exchange rates).
# Required. Get one at https://app.tavily.com (the free tier is enough).
TAVILY_API_KEY=

# ---------------------------------------------------------------------------
# Optional: LangSmith tracing (one trace per request, PII masked)
# ---------------------------------------------------------------------------

# Turn tracing on. Optional. Default: false.
LANGSMITH_TRACING=false
# LangSmith API key. Optional (required only when LANGSMITH_TRACING=true).
# Get one at https://smith.langchain.com (Settings > API Keys).
LANGSMITH_API_KEY=
# LangSmith project that receives the traces and the eval experiments.
# Optional. Default: getnet-challenge.
LANGSMITH_PROJECT=getnet-challenge

# ---------------------------------------------------------------------------
# Optional: overrides of the settings defaults (app/core/settings.py)
# Uncomment a line to change the default shown.
# ---------------------------------------------------------------------------

# Chat model for all agents, as "provider:model" for init_chat_model.
# CHAT_MODEL=openai:gpt-4.1-mini
# Embedding model for ingestion and retrieval. Changing it requires --rebuild.
# EMBEDDING_MODEL=text-embedding-3-small
# Timeout (seconds) and retries of every model call.
# LLM_TIMEOUT_SECONDS=30
# LLM_MAX_RETRIES=2
# Maximum tool calls per specialist run (stops tool loops).
# TOOL_CALL_LIMIT=6

# Knowledge base inputs and storage.
# SOURCES_FILE=data/sources.json
# CUSTOMERS_FILE=data/customers.json
# VECTORSTORE_DIR=.vectorstore
# COLLECTION_NAME=getnet_kb

# Chunking (characters). Changing it requires --rebuild.
# CHUNK_SIZE=1200
# CHUNK_OVERLAP=200

# Retrieval: chunks returned per search and the minimum relevance score (0 to 1).
# RETRIEVAL_K=4
# RETRIEVAL_MIN_SCORE=0.2

# Web search results per query.
# WEB_SEARCH_MAX_RESULTS=3

# Timezone of "today" for settlement dates.
# TIMEZONE=America/Sao_Paulo

# Log level of the JSON logs.
# LOG_LEVEL=INFO
